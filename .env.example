# OpenRouter API Configuration
AGENTIC_HIRE_OPENROUTER_API_KEY=sk-... (your API key here)

# JWT Configuration
# Generate a secret key with: python -c 'import secrets; print(secrets.token_urlsafe(32))'
# IMPORTANT: Change this in production!
AGENTIC_HIRE_JWT_SECRET_KEY=dev_secret_key_change_in_production

# PostgreSQL Database Configuration
AGENTIC_HIRE_DATABASE_URL=postgresql+asyncpg://agentic_hire:dev_password@db:5432/agentic_hire
POSTGRES_USER=agentic_hire
POSTGRES_PASSWORD=dev_password
POSTGRES_DB=agentic_hire

# OrioSearch Integration
AGENTIC_HIRE_ORIOSEARCH_BASE_URL=http://localhost:8000
