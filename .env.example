# ============================================================
# REQUIRED — the app will refuse to start without these
# ============================================================

# OpenRouter API key for all LLM calls (Scout, Orchestrator, Tailor, Vision)
# Get your key at: https://openrouter.ai/keys
AGENTIC_HIRE_OPENROUTER_API_KEY=sk-or-v1-...

# JWT signing secret — generate a fresh one before running:
#   python -c 'import secrets; print(secrets.token_urlsafe(32))'
# NEVER use the example value in production.
AGENTIC_HIRE_JWT_SECRET_KEY=replace-me-with-generated-secret

# PostgreSQL async connection string (matches docker-compose db service)
AGENTIC_HIRE_DATABASE_URL=postgresql+asyncpg://agentic_hire:dev_password@db:5432/agentic_hire

# PostgreSQL credentials (used by the db service in docker-compose)
POSTGRES_USER=agentic_hire
POSTGRES_PASSWORD=dev_password
POSTGRES_DB=agentic_hire

# ============================================================
# OPTIONAL — sensible defaults are used if not set
# ============================================================

# OrioSearch job discovery service URL (must be running locally on host)
# Default: http://host.docker.internal:8000
# AGENTIC_HIRE_ORIOSEARCH_BASE_URL=http://localhost:8000

# Logging level: DEBUG | INFO | WARNING | ERROR
# Default: DEBUG (development), set to INFO for production
# AGENTIC_HIRE_LOG_LEVEL=INFO

# Environment mode: development | production
# Controls debug mode, auto-reload, and log verbosity
# Default: development
# AGENTIC_HIRE_ENVIRONMENT=production

# Structured JSON logging for log aggregation (Datadog, Splunk, Loki)
# Default: false (human-readable plain text)
# AGENTIC_HIRE_JSON_LOGS=true
